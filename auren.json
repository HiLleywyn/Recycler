{
  "manifest_version": "1",
  "bot": {
    "slug": "recycler",
    "name": "Recycler",
    "version": "1.0.0",
    "description": "Free server backups, templates, chatlogs, sync and import/export, rendered in Discord Components V2.",
    "author": "HiLleywyn",
    "repo": "hilleywyn/recycler"
  },
  "channels": ["discord"],
  "discord": {
    "permissions": "805391380",
    "scopes": ["bot", "applications.commands"]
  },
  "runtime": {
    "dockerfile": "Dockerfile",
    "entrypoint": "main.py"
  },
  "credentials": [
    { "key": "DISCORD_TOKEN", "label": "Discord bot token", "secret": true }
  ],
  "provision": {
    "database": "postgres",
    "redis": true
  },
  "features": [
    "cogs.meta",
    "cogs.settings",
    "cogs.backups",
    "cogs.templates",
    "cogs.chatlog",
    "cogs.sync",
    "cogs.importexport"
  ],
  "settings": {
    "groups": [
      {
        "id": "general",
        "label": "General",
        "fields": [
          { "key": "PREFIX", "type": "string", "label": "Command prefix", "default": "." },
          { "key": "API_PORT", "type": "number", "label": "API / health port", "default": 8080 },
          { "key": "DISCORD_CLIENT_ID", "type": "string", "label": "Discord application (client) ID", "required": true, "help": "Required. From the Discord developer portal OAuth2 page; powers the Invite button." }
        ]
      },
      {
        "id": "backups",
        "label": "Backups",
        "fields": [
          { "key": "BACKUP_MAX_PER_USER", "type": "number", "label": "Max backups per user", "default": 50, "min": 1, "max": 1000 }
        ]
      },
      {
        "id": "api",
        "label": "REST API",
        "fields": [
          { "key": "CLANK_API_KEY", "type": "secret", "label": "API key (enables /api/v2)" }
        ]
      }
    ]
  }
}
