{
  "manifest_version": "1",

  "bot": {
    "slug": "recycler",
    "name": "Recycler",
    "description": "The ,clanker scammer/bot-account containment bot (Clanktank).",
    "author": "ericlancebrown",
    "version": "1.0.0",
    "repo": "https://github.com/HiLleywyn/Recycler"
  },

  "framework": { "package": "bot-framework", "min_version": "1.0.0" },

  "channels": ["discord"],

  "runtime": {
    "dockerfile": "Dockerfile",
    "entrypoint": "main.py",
    "resources": { "cpu": "0.5", "memory": "512Mi" }
  },

  "credentials": [
    { "key": "DISCORD_TOKEN",         "label": "Bot token",     "secret": true },
    { "key": "DISCORD_CLIENT_ID",     "label": "Client ID" },
    { "key": "DISCORD_CLIENT_SECRET", "label": "Client secret", "secret": true }
  ],

  "provision": {
    "database": "postgres"
  },

  "settings": {
    "groups": [
      { "id": "channels", "label": "Channel setup", "fields": [
          { "key": "CLANKTANK_CHANNEL_ID", "type": "discord_channel",
            "label": "Containment channel",
            "help": "Channel where CLANKER users are visible and ambience is active." },
          { "key": "CLANKTANK_LOG_CHANNEL_ID", "type": "discord_channel",
            "label": "Mod log channel",
            "help": "Where clanker add/remove/escape events are logged." },
          { "key": "CLANKER_ROLE_ID", "type": "discord_role",
            "label": "Clanker role",
            "help": "The containment role applied to caught accounts." },
          { "key": "CLANK_ESCAPE_THREAD_ID", "type": "discord_channel",
            "label": "Escape-room thread",
            "help": "Public thread where escape-room cases are posted." }
      ]},
      { "id": "clanktank", "label": "Clanktank", "fields": [
          { "key": "CLANK_ESCAPE_WAIT_MINUTES", "type": "number",
            "label": "Reflection wait (minutes)", "default": 8, "min": 1, "max": 120 }
      ]},
      { "id": "integrations", "label": "Integrations", "fields": [
          { "key": "LOG_LEVEL", "type": "select", "label": "Log level", "default": "INFO",
            "options": [
              { "value": "INFO",  "label": "Info" },
              { "value": "DEBUG", "label": "Debug" }
            ]
          }
      ]}
    ]
  },

  "features": [
    "cogs.clanktank"
  ]
}
