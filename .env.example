# ── Recycler configuration ────────────────────────────────────────────────────
# Recycler runs ALL ,clanker features and nothing else, on the shared
# bot-framework. Copy to .env and fill in.

# Discord
DISCORD_TOKEN=
PREFIX=,
APP_NAME=Recycler

# Data plane (managed PostgreSQL + Redis). The framework runs schema.sql +
# migrations (incl. clanker tables) automatically on first connect.
DATABASE_URL=postgresql://recycler:recycler@localhost:5432/recycler
REDIS_URL=redis://localhost:6379

# Recycler ships no dashboard/API; leave API_PORT empty so the framework
# skips the embedded HTTP server.
API_PORT=

# ── AI controller: route the ,clanker AI through Sojourns ─────────────────────
# The clanker AI feature (escape-room reformulation + scan scoring) calls the
# framework AI bridge. Setting SOJOURNS_AI_BASE_URL routes every completion
# through the Sojourns proxy gateway (the AI controller / management platform)
# instead of OpenRouter. SOJOURNS_AI_API_KEY is the tenant token Sojourns
# issued for this bot; SOJOURNS_BOT_ID attributes usage to it.
SOJOURNS_AI_BASE_URL=
SOJOURNS_AI_API_KEY=
SOJOURNS_BOT_ID=recycler

# Direct-to-OpenRouter fallback (used only when SOJOURNS_AI_BASE_URL is empty).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Clanker channel/role wiring (see core.config for the full list).
CLANKER_ROLE_ID=0

DEBUG=false
