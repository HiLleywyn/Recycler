# ── Recycler configuration ───────────────────────────────────────────
# Copy to .env for local development. On Railway, set these as service variables.

# Required ---------------------------------------------------------------------
DISCORD_TOKEN=                       # bot token from the Discord developer portal
DATABASE_URL=postgresql://user:pass@host:5432/recycler

# Core -------------------------------------------------------------------------
PREFIX=.                             # command prefix (".backup", ".template", ...)
API_PORT=8080                        # embedded REST API + /health port
DEBUG=false

# REST API (optional) ----------------------------------------------------------
CLANK_API_KEY=                       # set to enable /api/v2 (sent as X-API-Key)

# JWT_SECRET is OPTIONAL for Recycler: it only signs the framework's JWT
# dashboard sessions, which this bot does not use (the API auths with
# CLANK_API_KEY). When unset, main.py derives a stable non-default value so the
# framework's production guard passes. Set it only if you want to pin it.
# JWT_SECRET=

# Discord OAuth (optional, for invite link) ------------------------------------
DISCORD_CLIENT_ID=

# Backups ----------------------------------------------------------------------
BACKUP_MAX_PER_USER=50

# Redis (optional) -------------------------------------------------------------
# REDIS_URL=redis://localhost:6379
